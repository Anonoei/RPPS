{
  "extends": "apsk/32apsk",
  "comment": "DVB-S2 32APSK: the outer radii (gamma1, gamma2) follow the code rate (`rate`), the labelling does not",
  "ref": "EN 302 307-1 V1.2.1 5.4.4, table 10",
  "tags": ["dvb-s2"],
  "params": {
    "gamma1": null,
    "gamma2": null,
    "rate": {
      "default": null,
      "example": "3/4",
      "comment": [
        "the LDPC code rate, which sets gamma1 and gamma2, rings 2 and 3's radii over ring 1's (EN 302 307-1 table 10)"
      ],
      "choices": {
        "3/4": {"gamma1": 2.84, "gamma2": 5.27},
        "4/5": {"gamma1": 2.72, "gamma2": 4.87},
        "5/6": {"gamma1": 2.64, "gamma2": 4.64},
        "8/9": {"gamma1": 2.54, "gamma2": 4.33},
        "9/10": {"gamma1": 2.53, "gamma2": 4.3}
      }
    }
  },
  "rings": [
    {"n": 4, "pha": 45},
    {"n": 12, "pha": 15, "mag": {"param": "rate.gamma1"}},
    {"n": 16, "pha": 0, "mag": {"param": "rate.gamma2"}}
  ]
}
