{
  "extends": "apsk/16apsk",
  "comment": "DVB-S2 16APSK: the outer radius (gamma) follows the code rate (`rate`), the labelling does not",
  "ref": "EN 302 307-1 V1.2.1 5.4.3, table 9",
  "tags": ["dvb-s2"],
  "params": {
    "gamma": null,
    "rate": {
      "default": null,
      "example": "2/3",
      "comment": "the LDPC code rate, which sets gamma, ring 2's radius over ring 1's (EN 302 307-1 table 9)",
      "choices": {
        "2/3": {"gamma": 3.15},
        "3/4": {"gamma": 2.85},
        "4/5": {"gamma": 2.75},
        "5/6": {"gamma": 2.7},
        "8/9": {"gamma": 2.6},
        "9/10": {"gamma": 2.57}
      }
    }
  },
  "rings": [{"n": 4, "pha": 45}, {"n": 12, "pha": 15, "mag": {"param": "rate.gamma"}}]
}
